+model_name: longcat_next
+world_size: 1
+
+model_config:
+  model_name: longcat_next
+  model_path: /path/to/LongCat-Next
+  dtype: bfloat16
+  with_ckpt: True
+  exe_mode: eager
+  enable_cache_compile: False
+  enable_dynamic_graph: True
