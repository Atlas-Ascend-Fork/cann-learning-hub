+      generation:
+        do_sample: False
+        temperature: 0.7
+        top_p: 0.9
+        top_k: 50
+      visual_generation_config:
+        do_sample: True
+        temperature: 0.5
+        top_p: 0.75
+        top_k: 1024
+        custom_params:
+          cfg_scale: 1.8
+          token_h: 37
+          token_w: 37
+          anyres_prefix: "<longcat_img_token_size>{h} {w}</longcat_img_token_size>"
