+class CPUExpertStore:
+    """Host-resident expert weights used by the single-NPU offload path.
+
+    The store deliberately is not an ``nn.Module`` and its tensors are not
+    registered buffers/parameters, so the framework's blanket ``model.to(npu)``
+    cannot move them back into HBM.  Checkpoint shards are retained on CPU.
+    """
+
+    def __init__(self, num_experts, hidden_size, intermediate_size, dtype):
+        self.num_experts = num_experts
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+        self.dtype = dtype
+        self._loaded = {}
+
+    def load_shard(self, expert_id, shard_id, weight):
+        if not 0 <= expert_id < self.num_experts:
+            raise IndexError(f"expert_id={expert_id} is out of range")
+        expected = {
+            "w1": (self.intermediate_size, self.hidden_size),
+            "w2": (self.hidden_size, self.intermediate_size),
+            "w3": (self.intermediate_size, self.hidden_size),
+        }[shard_id]
+        if tuple(weight.shape) != expected:
+            raise ValueError(
+                f"expert {expert_id} {shard_id} shape={tuple(weight.shape)}, expected={expected}"
+            )
+        entry = self._loaded.setdefault(expert_id, {})
+        entry[shard_id] = weight.detach().to(device="cpu", dtype=self.dtype).contiguous()
+
+    def get_expert(self, expert_id):
+        loaded = self._loaded.get(expert_id)
+        if loaded is None:
+            raise RuntimeError(f"expert {expert_id} was not loaded from checkpoint")
+        missing = {"w1", "w2", "w3"} - loaded.keys()
+        if missing:
+            raise RuntimeError(
+                f"expert {expert_id} checkpoint is incomplete; missing {sorted(missing)}"
+            )
+        return loaded
+
+    def validate_loaded(self):
+        """Fail before inference when a real checkpoint is incomplete."""
+        missing_experts = []
+        incomplete_experts = {}
+        expected_shards = {"w1", "w2", "w3"}
+        for expert_id in range(self.num_experts):
+            shards = self._loaded.get(expert_id)
+            if shards is None:
+                missing_experts.append(expert_id)
+                continue
+            missing = expected_shards - shards.keys()
+            if missing:
+                incomplete_experts[expert_id] = sorted(missing)
+        if missing_experts or incomplete_experts:
+            missing_preview = missing_experts[:16]
+            raise RuntimeError(
+                "CPU expert checkpoint is incomplete: "
+                f"loaded={len(self._loaded)}/{self.num_experts}, "
+                f"missing_experts={missing_preview}"
+                f"{'...' if len(missing_experts) > len(missing_preview) else ''}, "
+                f"incomplete_experts={incomplete_experts}"
+            )
+        tensors = [tensor for shards in self._loaded.values() for tensor in shards.values()]
+        return {
+            "experts": len(self._loaded),
+            "tensors": len(tensors),
+            "bytes": sum(tensor.numel() * tensor.element_size() for tensor in tensors),
+        }
+
